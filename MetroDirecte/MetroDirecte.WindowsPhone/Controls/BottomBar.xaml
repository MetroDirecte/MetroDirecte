<UserControl
    x:Class="MetroDirecte.Controls.BottomBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Height="60">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                MinWidth="0"
                Click="Home_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <SymbolIcon Symbol="Home" HorizontalAlignment="Center"/>
                <TextBlock Text="accueil" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Column="1"
                MinWidth="0"
                Click="Calendar_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <SymbolIcon Symbol="Calendar" HorizontalAlignment="Center"/>
                <TextBlock Text="cours" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Column="2"
                MinWidth="0"
                Click="Grades_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <SymbolIcon Symbol="Document" HorizontalAlignment="Center"/>
                <TextBlock Text="notes" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Column="3"
                MinWidth="0"
                Click="Settings_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <SymbolIcon Symbol="Setting" HorizontalAlignment="Center"/>
                <TextBlock Text="paramètres" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>