<Page
    x:Class="MetroDirecte.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MetroDirecte"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Black">
        <StackPanel
        Margin="30"
        VerticalAlignment="Center">

            <TextBlock
            Text="MetroDirecte"
            FontSize="42"
            Foreground="White"
            Margin="0,0,0,40" />

            <TextBlock
            Text="Identifiant"
            FontSize="20"
            Foreground="White" />

            <TextBox
            x:Name="UsernameBox"
            PlaceholderText="Identifiant"
            Margin="0,5,0,20" />

            <TextBlock
            Text="Mot de passe"
            FontSize="20"
            Foreground="White" />

            <PasswordBox
            x:Name="PasswordBox"
            PlaceholderText="Mot de passe"
            Margin="0,5,0,30" />

            <Button
            x:Name="LoginButton"
            Content="SE CONNECTER"
            Click="LoginButton_Click" />

            <TextBlock
            x:Name="ErrorText"
            Text=""
            Foreground="Red"
            FontSize="16"
            Margin="0,15,0,0" />

        </StackPanel>
    </Grid>
</Page>
